{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "usahp-tauri-demo",
  "version": "0.1.0",
  "identifier": "com.willwade.usahp-demo",
  "build": {
    "frontendDist": "../../garyd-scanner-demo/dist",
    "beforeBuildCommand": "cd ../garyd-scanner-demo && npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "USAHP Switch Scanner",
        "width": 1024,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
